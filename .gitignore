# Top-level gitignore for the repository

# VS Code settings
.vscode/
*.code-workspace

# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# Virtual envs
venv/
env/
.venv/

# pytest cache
.pytest_cache/

# OS
Thumbs.db
*.DS_Store

# Logs and results
exports_suite/
results/
sweep_results.jsonl
/data/

# Tool caches
.ruff_cache/

# Generated plots and local experiment outputs (interactiondynamics)
interactiondynamics/plots/
interactiondynamics/analysis/plots/
interactiondynamics/results/
interactiondynamics/experiments/

# Downloaded / processed datasets (keep interactiondynamics/data/*.py source)
interactiondynamics/data/JODIE/
interactiondynamics/datasets/

